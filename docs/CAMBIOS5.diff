+html.black-theme .app-select-option:hover,
+html.black-theme .app-select-option-active { color: #fff; background: #414141; }
+html.black-theme .app-select-trigger:focus-visible { outline-color: #aaa; }
+
+/* El divisor del listado de instituciones no hereda el azul del modo oscuro. */
+html.black-theme .institution-filter-header,
+html.black-theme .institution-selection-details { border-color: #444; }
