+:root {
+  --module-max-width: 1600px;
+  --module-side-gap: clamp(28px, 3.5vw, 56px);
+}
+.app-content-container {
+  width: 100%;
+  max-width: var(--module-max-width);
+  margin-inline: auto;
+  padding-inline: var(--module-side-gap);
+}
+@media (max-width: 639px) {
+  :root { --module-side-gap: 16px; }
+}
+
+/* Menús de selección uniformes, con SOLO tres opciones visibles y scroll interno.
+   La lista está en un portal, por lo que no se corta dentro de modales. */
+.app-select-trigger:focus-visible { outline-offset: 2px; }
