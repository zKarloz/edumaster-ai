+class Result:
+    def __init__(self, row=None, rows=None):
+        self.row = row
+        self.rows = rows if rows is not None else []
+
+    def mappings(self):
+        return self
+
+    def first(self):
+        return self.row
+
+    def all(self):
+        return self.rows
+
+    def scalar_one(self):
+        return self.row
+
+    def scalar_one_or_none(self):
+        return self.row
