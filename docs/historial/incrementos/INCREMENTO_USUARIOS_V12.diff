+    assert response.status_code == 401
+    assert not engine.connection.statements
+
+
+@pytest.mark.parametrize("method,endpoint", [("GET", ""), ("POST", ""), ("DELETE", f"/{MEMBER}")])
+def test_non_superadmin_has_no_access(method, endpoint):
