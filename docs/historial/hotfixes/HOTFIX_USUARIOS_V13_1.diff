@@ -23,6 +23,66 @@
 .search-control { transition: border-color .18s ease, box-shadow .18s ease; }
 .search-control:focus-within { border-color: #087fe5; box-shadow: 0 0 0 2px rgb(8 127 229 / 22%); }
 .search-control input:focus, .search-control input:focus-visible { outline: none; box-shadow: none; }
+
+/* Superficies y controles compartidos: valores base para los tres temas.
+   La capa components permite que Tailwind sobrescriba estos valores en las
+   pantallas que ya tienen variantes específicas. Negro mantiene sus overrides. */
+:root {
+  --app-panel-bg: #ffffff;
+  --app-panel-border: #e2e8f0;
+  --app-text: #0f172a;
+  --app-muted-text: #64748b;
+  --app-control-bg: #ffffff;
+  --app-control-border: #cbd5e1;
+  --app-control-hover: #f1f5f9;
+  --app-primary-bg: #087fe5;
+  --app-primary-hover: #0669bd;
+}
+html.dark {
+  --app-panel-bg: #0a1f3d;
+  --app-panel-border: #23456a;
+  --app-text: #f1f5f9;
+  --app-muted-text: #cbd5e1;
+  --app-control-bg: #112a48;
+  --app-control-border: #345578;
+  --app-control-hover: #173658;
+}
+html.black-theme {
+  --app-panel-bg: #191919;
+  --app-panel-border: #383838;
+  --app-text: #ededed;
+  --app-muted-text: #b7b7b7;
+  --app-control-bg: #242424;
+  --app-control-border: #484848;
+  --app-control-hover: #303030;
+  --app-primary-bg: #5b5b5b;
+  --app-primary-hover: #737373;
+}
+@layer components {
+  .app-panel {
+    background-color: var(--app-panel-bg);
+    border-color: var(--app-panel-border);
+    color: var(--app-text);
+  }
+  .app-muted { color: var(--app-muted-text); }
+  .app-divider { border-color: var(--app-panel-border); }
+  .app-input, .app-secondary-button {
+    background-color: var(--app-control-bg);
+    border-color: var(--app-control-border);
+    color: var(--app-text);
+  }
+  .app-input::placeholder { color: var(--app-muted-text); }
+  button.app-secondary-button:hover:not(:disabled) {
+    background-color: var(--app-control-hover);
+  }
+  .app-primary-button {
+    background-color: var(--app-primary-bg);
+    color: #fff;
+  }
+  button.app-primary-button:hover:not(:disabled) {
+    background-color: var(--app-primary-hover);
+  }
+}
 
 /* Colores semánticos compartidos (sin depender del fondo propio de cada módulo).
    warning = requisito pendiente/error leve; info = orientación que no bloquea la acción. */
